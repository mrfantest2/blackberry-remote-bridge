import java.io.*;
import java.util.Date;
public class CP002Harness {
    static String banner = "Remote: off"; // host double for TorchOS.banner
    static int count;
    static void check(boolean value, String why) { count++; if(!value) throw new AssertionError(why); }
    static class RecordStore {
        static byte[] bytes; static boolean fail, failClose, failWrite; static int closes, writes, reads, opens, records=-1;
        static void reset() { bytes=null; fail=false; failClose=false; failWrite=false; closes=0; writes=0; reads=0; opens=0; records=-1; }
        static RecordStore openRecordStore(String name, boolean create) throws Exception {
            check(name.equals("TorchOS_CP002"), "isolated RMS name");
            opens++;
            if(fail) throw new Exception("denied"); return new RecordStore();
        }
        int getNumRecords() { return records>=0?records:(bytes==null?0:1); }
        int getRecordSize(int id) { return bytes.length; }
        byte[] getRecord(int id) { reads++;return bytes; }
        int addRecord(byte[] b,int o,int n) throws Exception { if(failWrite)throw new Exception("write denied"); bytes=b; writes++; return 1; }
        void setRecord(int id,byte[] b,int o,int n) throws Exception { if(failWrite)throw new Exception("write denied"); bytes=b; writes++; }
        void closeRecordStore() throws Exception { closes++; if(failClose)throw new Exception("close failure"); }
    }
    @@TerminalModel@@
    @@NoteData@@
    @@NoteCodec@@
    @@NoteStore@@
    @@CHILD@@
    static void bad(byte[] b) throws Exception {
        try { NoteCodec.decode(b); throw new AssertionError("corrupt accepted"); }
        catch(IOException expected) { count++; }
    }
    static boolean cleanHistory(TerminalModel t) {
        for(int i=0;i<t.historyCount;i++) {
            String entry=t.history[i];
            for(int j=0;j<entry.length();j++) {
                char c=entry.charAt(j);
                if(c<0x20||c==0x7F) return false;
            }
        }
        return true;
    }
    static void rejectControl(TerminalModel t, String raw, String label) {
        int historyBefore=t.historyCount;
        String outputBefore=t.output;
        String result=t.execute(raw);
        check(result.indexOf("Rejected")>=0,label+" rejected");
        check(t.historyCount==historyBefore,label+" not stored");
        check(t.output.indexOf("local> ",outputBefore.length())<0,label+" not echoed raw");
        check(cleanHistory(t),label+" history clean");
    }
    static String previousDraft(TerminalModel t, String input) throws Exception {
        try {
            java.lang.reflect.Method m=TerminalModel.class.getDeclaredMethod("previous", new Class[]{String.class});
            m.setAccessible(true); return (String)m.invoke(t, new Object[]{input});
        } catch(NoSuchMethodException e) { return t.previous(); }
    }
    static String nextDraft(TerminalModel t, String input) throws Exception {
        try {
            java.lang.reflect.Method m=TerminalModel.class.getDeclaredMethod("next", new Class[]{String.class});
            m.setAccessible(true); return (String)m.invoke(t, new Object[]{input});
        } catch(NoSuchMethodException e) { return t.next(); }
    }
    public static void main(String[] args) throws Exception {
        String mode=args[0];
        if(mode.equals("terminal")) {
            TerminalModel t=new TerminalModel();
            String[] allowed={"help","date","about","status","history","notes","files","remote"};
            for(int i=0;i<allowed.length;i++) check(t.execute(allowed[i]).indexOf("Rejected")<0,"allowed "+allowed[i]);
            String[] denied={"sh","root","status; reboot","help\nfiles","HELP","notes x","$(id)",""};
            for(int i=0;i<denied.length;i++) check(t.execute(denied[i]).indexOf("Rejected")>=0,"rejected "+denied[i]);
            check(t.execute("status").indexOf("Remote: off")>=0,"remote honest: off unless a session is active");
            check(t.execute("remote").indexOf("Remote: off")>=0,"remote command honest");
            check(t.execute("notes").indexOf("Notes & Tasks")>=0,"notes guidance");
            t.execute("clear"); check(t.output.length()==0,"clear output");
        } else if(mode.equals("bounds")) {
            TerminalModel t=new TerminalModel();
            for(int i=0;i<200;i++) t.execute("help");
            check(t.output.length()<=4096,"output bounded");check(t.historyCount==16,"history bounded");
            for(int i=0;i<20;i++) check(t.previous().equals("help"),"previous bounded");
            for(int i=0;i<20;i++) t.next(); check(t.next().equals(""),"history ends empty");
            int n=t.historyCount; StringBuffer longInput=new StringBuffer();
            for(int i=0;i<97;i++) longInput.append('a');
            check(t.execute(longInput.toString()).indexOf("Rejected")>=0,"oversized rejected");
            check(t.historyCount==n,"oversized not stored");
        } else if(mode.equals("codec")) {
            NoteData n=new NoteData();check(n.note.equals(""),"empty start");
            n.note="hello\n\u0645\u0631\u062d\u0628\u0627";n.tasks[1]=true;n.labels[0]="My device";
            byte[] b=NoteCodec.encode(n);NoteData d=NoteCodec.decode(b);
            check(d.note.equals(n.note)&&d.tasks[1]&&d.labels[0].equals("My device"),"roundtrip");
            for(int i=0;i<b.length;i++){byte[] cut=new byte[i];System.arraycopy(b,0,cut,0,i);bad(cut);}
            byte[] extra=new byte[b.length+1];System.arraycopy(b,0,extra,0,b.length);bad(extra);
            b[0]=0;bad(b);bad(new byte[2049]);
            n.note=new String(new char[513]);try{NoteCodec.encode(n);throw new AssertionError("long note");}catch(IOException expected){count++;}
            n.note="";n.labels[0]=new String(new char[41]);try{NoteCodec.encode(n);throw new AssertionError("long label");}catch(IOException expected){count++;}
            n.note="";n.labels[0]="";b=NoteCodec.encode(n);
            b[4]=2;bad(b);b[4]=1;b[7]=2;bad(b);
            n.note=new String(new char[512]).replace('\0','\u0645');n.labels[0]=new String(new char[40]).replace('\0','\u0645');
            check(NoteCodec.decode(NoteCodec.encode(n)).note.equals(n.note),"maximum Unicode note roundtrip");
        } else if(mode.equals("store")) {
            NoteStore s=new NoteStore();NoteData n=s.load();check(n.note.equals(""),"empty store");
            n.note="saved";check(s.save(n),"save succeeds");check(s.load().note.equals("saved"),"load succeeds");
            RecordStore.bytes=new byte[]{1,2,3};int writes=RecordStore.writes;
            check(s.load().note.equals(""),"corrupt not loaded");check(s.error.length()>0,"visible error");
            check(!s.save(n)&&RecordStore.writes==writes,"corrupt never overwritten");
            RecordStore.fail=true;s=new NoteStore();s.load();check(s.error.length()>0,"read denied visible");check(!s.save(n),"denied save");
            RecordStore.fail=false;RecordStore.bytes=null;s=new NoteStore();s.load();RecordStore.fail=true;
            check(!s.save(n)&&s.error.length()>0,"write denied visible");
            check(RecordStore.closes>=4,"stores closed");
            RecordStore.fail=false;RecordStore.bytes=new byte[2049];s=new NoteStore();int reads=RecordStore.reads;s.load();
            check(RecordStore.reads==reads,"oversized record not allocated or read");check(!s.save(n),"oversized record blocks save");
            RecordStore.bytes=null;RecordStore.records=2;s=new NoteStore();s.load();check(!s.save(n),"unexpected records preserved");
            RecordStore.records=-1;RecordStore.failClose=true;s=new NoteStore();s.load();check(s.error.length()>0&&!s.save(n),"load close failure blocks saves");
            RecordStore.failClose=false;s=new NoteStore();s.load();RecordStore.failClose=true;
            check(!s.save(n)&&s.error.length()>0,"save close failure is unconfirmed");
        } else if(mode.equals("store_revalidate")) {
            RecordStore.reset();
            NoteStore s=new NoteStore();NoteData n=s.load();n.note="baseline";check(s.save(n),"baseline save");
            byte[] corrupt=new byte[]{1,2,3};RecordStore.bytes=corrupt;
            int reads=RecordStore.reads,writes=RecordStore.writes;
            check(!s.save(n),"corrupt after load blocks overwrite");
            check(RecordStore.bytes==corrupt,"corrupt record identity preserved");
            check(RecordStore.writes==writes,"corrupt no write");
            check(RecordStore.reads==reads+1,"corrupt existing record read once");
            check(s.error.length()>0,"corrupt visible error");
            int blockedOpens=RecordStore.opens;
            check(!s.save(n)&&RecordStore.writes==writes,"corrupt state stays blocked");
            check(RecordStore.opens==blockedOpens,"corrupt state does not reopen");
            RecordStore.reset();
            s=new NoteStore();n=s.load();n.note="baseline";check(s.save(n),"second baseline save");
            byte[] oversize=new byte[2049];RecordStore.bytes=oversize;
            reads=RecordStore.reads;writes=RecordStore.writes;
            check(!s.save(n),"oversize after load blocks overwrite");
            check(RecordStore.bytes==oversize,"oversize record identity preserved");
            check(RecordStore.writes==writes,"oversize no write");
            check(RecordStore.reads==reads,"oversize not read or allocated");
            check(s.error.length()>0,"oversize visible error");
            blockedOpens=RecordStore.opens;
            check(!s.save(n)&&RecordStore.writes==writes,"oversize state stays blocked");
            check(RecordStore.opens==blockedOpens,"oversize state does not reopen");
            RecordStore.reset();
            s=new NoteStore();check(s.load().note.equals(""),"third store empty");
            n.note="baseline";check(s.save(n),"third baseline save");
            byte[] single=RecordStore.bytes;RecordStore.records=2;
            reads=RecordStore.reads;writes=RecordStore.writes;
            check(!s.save(n),"unexpected count after load blocks overwrite");
            check(RecordStore.bytes==single,"unexpected count record identity preserved");
            check(RecordStore.writes==writes,"unexpected count no write");
            check(RecordStore.reads==reads,"unexpected count not read");
            check(s.error.length()>0,"unexpected count visible error");
            blockedOpens=RecordStore.opens;
            check(!s.save(n)&&RecordStore.writes==writes,"unexpected count state stays blocked");
            check(RecordStore.opens==blockedOpens,"unexpected count state does not reopen");
        } else if(mode.equals("store_fail_closed")) {
            RecordStore.reset();
            NoteStore s=new NoteStore();NoteData n=s.load();n.note="valid";n.labels[0]="Owner";
            RecordStore.fail=true;
            check(!s.save(n),"open failure save rejected");
            check(s.error.length()>0,"open failure visible");
            RecordStore.fail=false;int opens=RecordStore.opens,writes=RecordStore.writes;
            check(!s.save(n),"open failure blocks later save");
            check(RecordStore.opens==opens,"blocked state does not reopen");
            check(RecordStore.writes==writes,"blocked state does not write");
            RecordStore.reset();
            s=new NoteStore();n=s.load();n.note="valid";check(s.save(n),"write baseline");
            RecordStore.failWrite=true;
            check(!s.save(n),"write failure save rejected");
            check(s.error.length()>0,"write failure visible");
            RecordStore.failWrite=false;writes=RecordStore.writes;
            check(!s.save(n)&&RecordStore.writes==writes,"write failure blocks later save");
            RecordStore.reset();
            s=new NoteStore();n=s.load();n.note="close";
            RecordStore.failClose=true;
            check(!s.save(n),"close failure not confirmed");
            check(s.error.length()>0,"close failure visible");
            check(RecordStore.writes==1,"close failure wrote once");
            RecordStore.failClose=false;writes=RecordStore.writes;opens=RecordStore.opens;
            check(!s.save(n),"close failure blocks second save");
            check(RecordStore.writes==writes,"close failure no second write");
            check(RecordStore.opens==opens,"close failure no reopen");
            RecordStore.reset();
            s=new NoteStore();n=s.load();n.note="valid";check(s.save(n),"invalid baseline");
            byte[] before=RecordStore.bytes;writes=RecordStore.writes;opens=RecordStore.opens;
            NoteData bad=new NoteData();bad.labels[0]=new String(new char[41]);
            check(!s.save(bad),"invalid draft rejected");
            check(RecordStore.bytes==before,"invalid draft preserves record");
            check(RecordStore.writes==writes,"invalid draft no write");
            check(RecordStore.opens==opens,"invalid draft no storage open");
            check(s.error.length()>0,"invalid draft visible");
            check(s.save(n),"invalid draft does not block valid retry");
        } else if(mode.equals("controls")) {
            TerminalModel t=new TerminalModel();
            for(int c=0;c<0x20;c++) {
                char control=(char)c;
                rejectControl(t,control+"help","leading control "+c);
                rejectControl(t,"help"+control,"trailing control "+c);
                rejectControl(t,"hel"+control+"p","embedded control "+c);
            }
            char del=(char)0x7F;
            rejectControl(t,del+"help","leading DEL");
            rejectControl(t,"help"+del,"trailing DEL");
            rejectControl(t,"hel"+del+"p","embedded DEL");
            int historyBefore=t.historyCount;
            check(t.execute(null).indexOf("Rejected")>=0,"null rejected");
            check(t.historyCount==historyBefore,"null not stored");
            check(cleanHistory(t),"null history clean");
            check(t.execute("  help  ").indexOf("Rejected")<0,"surrounding ASCII spaces allowed");
            check(t.history[t.historyCount-1].equals("help"),"spaces normalized out of history");
            check(t.execute("  status  ").indexOf("Remote: off")>=0,"spaced allowed command runs");
            check(cleanHistory(t),"accepted history clean");
            check(t.execute("\nhelp").indexOf("Rejected")>=0,"newline still rejected");
            check(t.execute("help").indexOf("Rejected")<0,"terminal recovers after rejection");
        } else if(mode.equals("history_draft")) {
            TerminalModel t=new TerminalModel();
            t.execute("help");
            int historyBefore=t.historyCount; String outputBefore=t.output;
            check(previousDraft(t,"sta").equals("help"),"previous recalls newest history");
            check(nextDraft(t,"help").equals("sta"),"next restores typed draft");
            check(t.historyCount==historyBefore,"navigation does not mutate history");
            check(t.output.equals(outputBefore),"navigation does not write output");

            TerminalModel multi=new TerminalModel();
            multi.execute("help"); multi.execute("status");
            check(previousDraft(multi,"sta").equals("status"),"first previous recalls newest");
            check(previousDraft(multi,"status").equals("help"),"second previous recalls older");
            check(nextDraft(multi,"help").equals("status"),"next returns toward newest");
            check(nextDraft(multi,"status").equals("sta"),"next restores saved draft after multiple previous");
            check(nextDraft(multi,"edited").equals("edited"),"repeated next at newest preserves live draft");
            check(multi.historyCount==2,"browsing never mutates history");

            TerminalModel empty=new TerminalModel();
            check(previousDraft(empty,"sta").equals("sta"),"empty history previous keeps typed text");
            check(nextDraft(empty,"sta").equals("sta"),"empty history next keeps typed text");

            TerminalModel bounded=new TerminalModel();
            bounded.execute("help");
            StringBuffer oversized=new StringBuffer();
            for(int i=0;i<200;i++) oversized.append('q');
            check(previousDraft(bounded,oversized.toString()).equals("help"),"oversized draft still recalls history");
            String restored=nextDraft(bounded,"help");
            check(restored.length()==TerminalModel.INPUT_LIMIT,"draft bounded to input limit");
            check(previousDraft(bounded,null)!=null,"null draft input remains safe");
            nextDraft(bounded,null);
            check(bounded.historyCount==1,"draft never stored in history");
            check(bounded.output.indexOf("qqqq")<0,"draft never written to output");

            TerminalModel reset=new TerminalModel();
            reset.execute("help");
            previousDraft(reset,"sta");
            reset.execute("status");
            check(nextDraft(reset,"").equals(""),"submission clears saved draft");
            check(previousDraft(reset,"").equals("status"),"submission resets browsing state");
            check(nextDraft(reset,"status").equals(""),"cleared draft restored after submission");
            previousDraft(reset,"again");
            reset.execute("clear");
            check(nextDraft(reset,"").equals(""),"clear leaves empty draft");
            check(previousDraft(reset,"").equals("clear"),"clear resets browsing to newest");

            TerminalModel plain=new TerminalModel();
            plain.execute("help");
            check(plain.previous().equals("help"),"no-argument previous remains compatible");
            check(plain.next().equals(""),"no-argument next at newest remains compatible");
        } else if(mode.equals("history_rejected_reset")) {
            TerminalModel control=new TerminalModel();
            control.execute("help"); control.execute("date");
            previousDraft(control,"sta");
            int controlHistory=control.historyCount; String controlOutput=control.output;
            check(control.execute("\u0001help").indexOf("Rejected")>=0,"rejected control submission");
            check(control.historyCount==controlHistory,"rejected control not stored");
            check(control.output.indexOf("\u0001help",controlOutput.length())<0,"rejected control not echoed raw");
            check(nextDraft(control,"").equals(""),"rejected control does not restore stale draft");

            TerminalModel nulled=new TerminalModel();
            nulled.execute("help"); nulled.execute("date");
            previousDraft(nulled,"sta");
            int nullHistory=nulled.historyCount; String nullOutput=nulled.output;
            check(nulled.execute(null).indexOf("Rejected")>=0,"rejected null submission");
            check(nulled.historyCount==nullHistory,"rejected null not stored");
            check(nulled.output.indexOf("Rejected",nullOutput.length())>=0,"rejected null stays visible");
            check(nextDraft(nulled,"").equals(""),"rejected null does not restore stale draft");

            TerminalModel over=new TerminalModel();
            over.execute("help"); over.execute("date");
            previousDraft(over,"sta");
            StringBuffer tooLong=new StringBuffer();
            for(int i=0;i<97;i++) tooLong.append('z');
            int overHistory=over.historyCount; String overOutput=over.output;
            check(over.execute(tooLong.toString()).indexOf("Rejected")>=0,"rejected overlimit submission");
            check(over.historyCount==overHistory,"rejected overlimit not stored");
            check(over.output.indexOf("zzzz",overOutput.length())<0,"rejected overlimit not echoed raw");
            check(nextDraft(over,"").equals(""),"rejected overlimit does not restore stale draft");
        } else if(mode.equals("files")) {
            String[] bad={"../","..","/root/","a/b/","a\\b","a:b","%2e%2e/","","./","a\n"};
            for(int i=0;i<bad.length;i++) check(!safeChild(bad[i]),"unsafe name "+i);
            check(safeChild("documents/"),"folder allowed");check(safeChild("a.txt"),"file allowed");
        } else throw new AssertionError(mode);
        System.out.println(mode+": "+count+" assertions passed (host only)");
    }
}
